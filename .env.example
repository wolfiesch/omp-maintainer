# Copy this file only for manual configuration. The preferred `omp-maintainer setup`
# command creates a new env file and refuses to overwrite an existing one.
# Replace every uncommented REPLACE_WITH_... value before starting Compose.
# Do not commit the resulting .env file or the GitHub App private-key file.

# GitHub App identity. The private key is mounted into github-broker only.
GITHUB_APP_ID=REPLACE_WITH_NUMERIC_GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY_PATH=REPLACE_WITH_PRIVATE_KEY_FILE_PATH
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_WEBHOOK_SECRET
OMP_MAINTAINER_GH_PROXY_HMAC_KEY=REPLACE_WITH_LONG_RANDOM_BROKER_HMAC_KEY

# Repository identity and explicit scope.
OMP_MAINTAINER_BOT_LOGIN=REPLACE_WITH_GITHUB_APP_LOGIN
OMP_MAINTAINER_GIT_AUTHOR_NAME=REPLACE_WITH_GIT_AUTHOR_NAME
OMP_MAINTAINER_GIT_AUTHOR_EMAIL=REPLACE_WITH_GIT_AUTHOR_EMAIL
OMP_MAINTAINER_REPO_ALLOWLIST=REPLACE_WITH_COMMA_SEPARATED_OWNER_REPOSITORY_NAMES
OMP_MAINTAINER_MAINTAINER_LOGINS=REPLACE_WITH_COMMA_SEPARATED_GITHUB_LOGINS

# OMP selection. Keep provider compatible with model.
OMP_MAINTAINER_PROVIDER=REPLACE_WITH_OMP_PROVIDER
OMP_MAINTAINER_MODEL=REPLACE_WITH_OMP_MODEL
OMP_MAINTAINER_THINKING=REPLACE_WITH_OMP_THINKING_LEVEL

# Optional local listener and capacity settings. Uncomment only after replacing.
# OMP_MAINTAINER_HTTP_PORT=REPLACE_WITH_LOCAL_TCP_PORT
# OMP_MAINTAINER_MAX_CONCURRENCY=REPLACE_WITH_CONSERVATIVE_CONCURRENCY
# OMP_MAINTAINER_TASK_MAX_COST_USD=REPLACE_WITH_POST_TURN_TASK_COST_LIMIT
# OMP_MAINTAINER_TASK_MAX_TOKENS=REPLACE_WITH_POST_TURN_TASK_TOKEN_LIMIT
# OMP_MAINTAINER_RELEASE_MAX_COST_USD=REPLACE_WITH_POST_TURN_RELEASE_COST_LIMIT
# OMP_MAINTAINER_RELEASE_MODEL=REPLACE_WITH_RELEASE_ONLY_OMP_MODEL

# Optional manual intervention token. Leave this line commented to disable the
# dashboard's manual triage, retry, cancellation, and replay endpoints.
# OMP_MAINTAINER_REPLAY_TOKEN=REPLACE_WITH_LONG_RANDOM_INTERVENTION_TOKEN

# Optional release handling. Keep these commented unless both the service and
# the repository policy have been reviewed for release publication.
# OMP_MAINTAINER_RELEASE_SENTINEL_ENABLED=REPLACE_WITH_BOOLEAN_RELEASE_OPT_IN
# OMP_MAINTAINER_RELEASE_MAX_ROUNDS=REPLACE_WITH_POSITIVE_RELEASE_ROUND_LIMIT
# OMP_MAINTAINER_RELEASE_TASK_TIMEOUT_SECONDS=REPLACE_WITH_POSITIVE_RELEASE_TIMEOUT_SECONDS

# Optional direct provider credentials. Uncomment exactly the credential or
# endpoint required by the selected provider. These reach OMP task subprocesses.
# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
# ANTHROPIC_OAUTH_TOKEN=REPLACE_WITH_ANTHROPIC_OAUTH_TOKEN
# OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# OPENAI_CODEX_OAUTH_TOKEN=REPLACE_WITH_OPENAI_CODEX_OAUTH_TOKEN
# GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
# OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
# MISTRAL_API_KEY=REPLACE_WITH_MISTRAL_API_KEY
# XAI_API_KEY=REPLACE_WITH_XAI_API_KEY
# CEREBRAS_API_KEY=REPLACE_WITH_CEREBRAS_API_KEY
# DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
# TOGETHER_API_KEY=REPLACE_WITH_TOGETHER_API_KEY
# OPENAI_BASE_URL=REPLACE_WITH_OPENAI_COMPATIBLE_BASE_URL
# OLLAMA_BASE_URL=REPLACE_WITH_OLLAMA_BASE_URL
# LM_STUDIO_BASE_URL=REPLACE_WITH_LM_STUDIO_BASE_URL
# LLAMA_CPP_BASE_URL=REPLACE_WITH_LLAMA_CPP_BASE_URL
